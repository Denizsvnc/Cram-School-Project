generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roller {
  YONETICI
  MUDUR
  OGRETMEN
  OGRENCI
  VELI
  PERSONEL
  ESKI_OGRENCI
  ESKI_PERSONEL
  ESKI_VELI
}

model Kullanici {
  id       String @id @default(uuid())
  isim     String @db.VarChar(70)
  soy_isim String @db.VarChar(70)

  tel_no       String   @db.VarChar(15)
  mail         String   @unique @db.VarChar(255)
  sifre        String   @db.VarChar(300)
  tc_no        String   @unique @db.VarChar(11)
  milliyet     String   @default("TR")
  dogum_tarihi DateTime
  rol          Roller   @default(OGRENCI)
  ogrenciNo    Int?     @unique
  personelNo   Int?     @unique
  kimlikNo     Int?     @unique // 6 haneli benzersiz numara

  egitim_durumu String
  // Öğrenci İse zorunlu
  odeme_plani   String?
  odeme_durumu  Boolean?
  odeme_tutari  Float? // Toplam ücret (TL)
  taksit_sayisi Int? // Kaç taksit (ay)

  // öğretmen, müdür, personel ise zorunlu olmalı 
  maas            String?
  maas_odendi_mi  Boolean? // Bu ayki maaş ödendi mi
  izin_hakki      Int? // Toplam yıllık izin günü
  kullanilan_izin Int? // Kullanılan izin günü
  profil_foto_url String?

  veli_ID    String?
  veli       Kullanici?  @relation("VeliOgrenciler", fields: [veli_ID], references: [id])
  ogrenciler Kullanici[] @relation("VeliOgrenciler")

  // Öğrencinin Bağlı Olduğu Sınıf
  sinifId String?
  sinif   Sinif?  @relation(fields: [sinifId], references: [id])

  // Öğretmenin ve Öğrencinin sistemdeki genel kayıtları
  ogretmenProgramlari DersProgrami[] @relation("OgretmenProgrami")
  notlar              SinavNotu[]
  yoklamalar          Yoklama[]
  odemeler            Odeme[]

  // Yeni Modüller için İlişkiler
  duyurular            Duyuru[]
  ogretmenOdevleri     Odev[]
  ogrenciOdevTeslimler OdevTeslim[]
  dersMateryalleri     DersMateryali[]
  veliGorusmeleri      VeliGorusme[]     @relation("VeliGorusmeleri")
  ogretmenGorusmeleri  VeliGorusme[]     @relation("OgretmenGorusmeleri")
  izinTalepleri        IzinTalebi[]

  sessions Session[]

  aktifMi Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sinif {
  id       String @id @default(uuid())
  isim     String @unique // Örn: "12-A Sayısal"
  kapasite Int

  ogrenciler Kullanici[]
  programlar DersProgrami[]
  odevler    Odev[]
  materyaller DersMateryali[]
  aktifMi    Boolean        @default(true)
}

model Ders {
  id   String @id @default(uuid())
  isim String @unique

  ders_suresi Int            @default(40)
  programlar  DersProgrami[]
  notlar      SinavNotu[]
  odevler     Odev[]
  materyaller DersMateryali[]
  sinavTakvimi SinavTakvimi[]
}

model DersProgrami {
  id        String @id @default(uuid())
  gun       Int // 1: Pazartesi, 7: Pazar vb.
  baslangic String // Örn: "09:00"
  bitis     String // Örn: "09:45"

  sinifId String
  sinif   Sinif  @relation(fields: [sinifId], references: [id], onDelete: Cascade)

  dersId String
  ders   Ders   @relation(fields: [dersId], references: [id], onDelete: Cascade)

  ogretmenId String
  ogretmen   Kullanici @relation("OgretmenProgrami", fields: [ogretmenId], references: [id], onDelete: Cascade)

  yoklamalar Yoklama[]
}

model SinavNotu {
  id       String   @id @default(uuid())
  sinavAdi String // Örn: matematik sınavi
  puan     Float
  tarih    DateTime @default(now())

  ogrenciId String
  ogrenci   Kullanici @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)

  dersId String
  ders   Ders   @relation(fields: [dersId], references: [id], onDelete: Cascade)
}

model Yoklama {
  id             String   @id @default(uuid())
  tarih          DateTime @default(now())
  derseKatildiMi Boolean  @default(false)

  ogrenciId String
  ogrenci   Kullanici @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)

  dersProgramiId String
  dersProgrami   DersProgrami @relation(fields: [dersProgramiId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  userId String
  user   Kullanici @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Odeme {
  id             String    @id @default(uuid())
  kullaniciId    String
  kullanici      Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  miktar         Float
  tarih          DateTime  @default(now())
  sonOdemeTarihi DateTime?
  durum          String    @default("BEKLIYOR") // BEKLIYOR, ODENDI, ONAYLANDI, IPTAL
  aciklama       String?
}

model Duyuru {
  id       String   @id @default(uuid())
  baslik   String   @db.VarChar(150)
  icerik   String   @db.Text
  hedefRol String   @default("HEPSI") // HEPSI, OGRETMEN, OGRENCI, VELI
  tarih    DateTime @default(now())

  yazarId  String
  yazar    Kullanici @relation(fields: [yazarId], references: [id], onDelete: Cascade)
}

model Odev {
  id            String   @id @default(uuid())
  baslik        String   @db.VarChar(150)
  aciklama      String   @db.Text
  teslimTarihi  DateTime
  createdAt     DateTime @default(now())

  sinifId       String
  sinif         Sinif    @relation(fields: [sinifId], references: [id], onDelete: Cascade)

  dersId        String
  ders          Ders     @relation(fields: [dersId], references: [id], onDelete: Cascade)

  ogretmenId    String
  ogretmen      Kullanici @relation(fields: [ogretmenId], references: [id], onDelete: Cascade)

  teslimler     OdevTeslim[]
}

model OdevTeslim {
  id                String    @id @default(uuid())
  odevId            String
  odev              Odev      @relation(fields: [odevId], references: [id], onDelete: Cascade)
  ogrenciId         String
  ogrenci           Kullanici @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)
  tamamlandi        Boolean   @default(false)
  tamamlanmaTarihi  DateTime?
}

model DersMateryali {
  id         String   @id @default(uuid())
  baslik     String   @db.VarChar(150)
  aciklama   String?  @db.Text
  dosyaUrl   String   @db.Text
  createdAt  DateTime @default(now())

  sinifId    String
  sinif      Sinif    @relation(fields: [sinifId], references: [id], onDelete: Cascade)

  dersId     String
  ders       Ders     @relation(fields: [dersId], references: [id], onDelete: Cascade)

  ogretmenId String
  ogretmen   Kullanici @relation(fields: [ogretmenId], references: [id], onDelete: Cascade)
}

model SinavTakvimi {
  id       String   @id @default(uuid())
  sinavAdi String   @db.VarChar(150)
  tarih    DateTime

  dersId   String
  ders     Ders     @relation(fields: [dersId], references: [id], onDelete: Cascade)
}

model VeliGorusme {
  id          String   @id @default(uuid())
  tarih       DateTime
  saat        String   @db.VarChar(10) // "14:30"
  durum       String   @default("BEKLIYOR") // BEKLIYOR, ONAYLANDI, REDDEDILDI
  aciklama    String?  @db.VarChar(250)

  veliId      String
  veli        Kullanici @relation("VeliGorusmeleri", fields: [veliId], references: [id], onDelete: Cascade)

  ogretmenId  String
  ogretmen    Kullanici @relation("OgretmenGorusmeleri", fields: [ogretmenId], references: [id], onDelete: Cascade)
}

model IzinTalebi {
  id          String   @id @default(uuid())
  baslangic   DateTime
  bitis       DateTime
  sebep       String   @db.Text
  durum       String   @default("BEKLIYOR") // BEKLIYOR, ONAYLANDI, REDDEDILDI
  createdAt   DateTime @default(now())

  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
}